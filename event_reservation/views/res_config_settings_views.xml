<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.event</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="65"/>
            <field name="inherit_id" ref="event.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/app[@name='event']/block[@name='registration_setting_container']/setting[last()]" position="after">
                    <setting id="auto_confirm_reserved" company_dependent="1" help="Enable Auto Confirm Reserved">
                        <field name="auto_confirm_reserved"/>
                    </setting>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
