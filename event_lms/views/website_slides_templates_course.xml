<odoo>
    <template id="course_join" inherit_id="website_slides.course_join">
        <xpath expr="//div[hasclass('alert') and hasclass('my-0') and hasclass('bg-100')]/div" position="replace">
            <div>
                <small>
                    Finish
                    <a t-if="len(channel.prerequisite_channel_ids) == 1"
                        t-attf-href="/slides/{{channel.prerequisite_channel_ids[0].id}}"
                        t-out="channel.prerequisite_channel_ids[0].name"/>
                    <a t-else="" href="#" class="o_wslides_js_prerequisite_course"
                        t-att-data-channels="json.dumps(
                            [{'course_id': course.id, 'course_name': course.name}
                            for course in channel.prerequisite_channel_ids]
                        )">
                        courses
                    </a>
                </small>
            </div>
        </xpath>
    </template>

    <template id="slide_fullscreen_sidebar_category" name="Slides category template for fullscreen view side bar" inherit_id="website_slides.slide_fullscreen_sidebar_category">
        <xpath expr="//li[hasclass('o_wslides_fs_sidebar_list_item')]" position="attributes">
            <attribute name="t-att-data-event-type-id">slug(slide.event_type_id) if slide.slide_category == 'event_type' and slide.event_type_id else ''</attribute>
        </xpath>
    </template>


    <template id="slide_aside_training_category" name="Category item for the slide detailed view list" inherit_id="website_slides.slide_aside_training_category">
        <xpath expr="//a[@t-att-href=&quot;'/slides/slide/%s' % (slug(aside_slide)) if can_access else '#'&quot;]" position="attributes">
            <attribute name="t-att-href">'/event-type/%s' % (slug(aside_slide.event_type_id)) if can_access and aside_slide.slide_category == 'event_type' else '/slides/slide/%s' % (slug(aside_slide)) if can_access else '#'</attribute>
        </xpath>
    </template>

    <template id="slide_content_detailed" name="Slide: Detailed Content" inherit_id="website_slides.slide_content_detailed">
        <!-- Update previous button -->
        <xpath expr="//a[@t-att-href=&quot;'/slides/slide/%s' % (slug(previous_slide)) if previous_slide else '#'&quot;]" position="attributes">
            <attribute name="t-att-href">'/event-type/%s' % (slug(previous_slide.event_type_id)) if previous_slide and previous_slide.slide_category == 'event_type' else '/slides/slide/%s' % (slug(previous_slide)) if previous_slide else '#'</attribute>
        </xpath>

        <!-- Update next button -->
        <xpath expr="//a[@t-att-href=&quot;'/slides/slide/%s' % (slug(next_slide)) if next_slide else '#'&quot;]" position="attributes">
            <attribute name="t-att-href">'/event-type/%s' % (slug(next_slide.event_type_id)) if next_slide and next_slide.slide_category == 'event_type' else '/slides/slide/%s' % (slug(next_slide)) if next_slide else '#'</attribute>
        </xpath>

        <!-- Update fullscreen button -->
        <xpath expr="//a[@t-att-href=&quot;'/slides/slide/%s?fullscreen=1' % (slug(slide))&quot;]" position="attributes">
            <attribute name="t-att-href">'/event-type/%s?fullscreen=1' % (slug(slide.event_type_id)) if slide.slide_category == 'event_type' else '/slides/slide/%s?fullscreen=1' % (slug(slide))</attribute>
        </xpath>
    </template>

    <template id="lesson_content_quiz" name="Lesson: Quiz specific content" inherit_id="website_slides.lesson_content_quiz">
        <xpath expr="//div[@class='o_wslides_js_lesson_quiz col']" position="attributes">
            <attribute name="t-att-data-next-slide-url">'/event-type/%s' % (slug(next_slide.event_type_id)) if next_slide and next_slide.slide_category == 'event_type' else '/slides/slide/%s' % (slug(next_slide)) if next_slide else None</attribute>
        </xpath>
    </template>

    <template id="course_slides_list_slide" inherit_id="website_slides.course_slides_list_slide">
        <xpath expr="//div[hasclass('text-truncate', 'me-auto')]" position="replace">
            <div class="text-truncate me-auto">
                <!-- Check if slide category is event_type -->
                <a t-if="not invite_preview and (slide.is_preview or channel.is_member or channel.can_publish) and slide.slide_category == 'event_type'"
                   class="o_wslides_js_slides_list_slide_link"
                   t-attf-href="/event-type/#{slug(slide.event_type_id)}">
                    <span t-field="slide.name"/>
                </a>
                <!-- Default behavior for non-event_type slides -->
                <a t-elif="not invite_preview and (slide.is_preview or channel.is_member or channel.can_publish)"
                   class="o_wslides_js_slides_list_slide_link"
                   t-attf-href="/slides/slide/#{slug(slide)}">
                    <span t-field="slide.name"/>
                </a>
                <!-- Fallback for cases where link shouldn't be shown -->
                <span t-else="">
                    <span t-esc="slide.name"/>
                </span>
            </div>
        </xpath>
    </template>



