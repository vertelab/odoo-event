<odoo>
  
  <template id="course_join" inherit_id="website_slides.course_join">
    <xpath expr="//div[hasclass('alert') and hasclass('my-0') and hasclass('bg-100')]/div" position="replace">
        <div>
            <small>
                Finish
                <a t-if="len(channel.prerequisite_channel_ids) == 1"
                    t-attf-href="/slides/{{channel.prerequisite_channel_ids[0].id}}"
                    t-out="channel.prerequisite_channel_ids[0].name"/>
                <a t-else="" href="#" class="o_wslides_js_prerequisite_course"
                    t-att-data-channels="json.dumps(
                        [{'course_id': course.id, 'course_name': course.name}
                        for course in channel.prerequisite_channel_ids]
                    )">
                    courses
                </a>
            </small>
        </div>
    </xpath>
  </template>
  
  
  <template id="course_slides_list_slide" name="Slide template for a training channel" inherit_id="website_slides.course_slides_list_slide">
   <xpath expr="//li//div[@class='text-truncate me-auto']" position="replace">
            <a t-if="not invite_preview and (slide.is_preview or channel.is_member or channel.can_publish or slide.slide_category != 'event_type')" class="o_wslides_js_slides_list_slide_link" t-attf-href="/slides/slide/#{slug(slide)}">
                <span t-field="slide.name"/>
            </a>
            <a t-elif="not invite_preview and (slide.is_preview or channel.is_member or channel.can_publish or slide.slide_category == 'event_type')" class="o_wslides_js_slides_list_slide_link" t-attf-href="/event-type/{slug(slide.event_type_id)}">
                <span t-field="slide.name"/>
            </a>
            <span t-else="">
                <span t-esc="slide.name"/>
            </span>
    </xpath>
<!--
    <li t-att-index="j" t-att-data-slide-id="slide.id" t-att-data-category-id="category_id" t-attf-class="o_wslides_slides_list_slide o_wslides_js_list_item bg-white-50 border-top-0 d-flex align-items-center ps-2 #{'py-1 pe-2' if not channel.can_upload else ''}">
        <div t-if="channel.can_publish" class=" o_wslides_slides_list_drag m-2 o_not_editable">
