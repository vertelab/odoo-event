<odoo>
	<template id="portal_my_home_events" name="Add Button" inherit_id="website_event_portal.event_my_event_registration" customize_show="True" priority="30">
		<xpath expr="//span[@t-field='event_registration.event_id.description']" position="after">
		 	<a t-if="event_registration.event_id.slide_channel_id" t-attf-href="/slides/#{ slug(event_registration.event_id.slide_channel_id) }" t-att-title="event_registration.event_id.slide_channel_id.name">
        		<button class="btn btn-primary py-2 w-40">Gå till utbildningen</button>
      		</a>
		</xpath>
	</template>
</odoo>
