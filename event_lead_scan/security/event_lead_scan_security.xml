<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_event_lead_scan" model="ir.module.category">
        <field name="name">Event Lead Scanning</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_scan_manager" model="res.groups">
        <field name="name">Scan Manager</field>
        <field name="category_id" ref="module_category_event_lead_scan"/>
        <field name="comment">Manage scan sessions and their leads.</field>
    </record>

    <record id="group_scan_user" model="res.groups">
        <field name="name">Scan User</field>
        <field name="category_id" ref="module_category_event_lead_scan"/>
        <field name="comment">Read scan sessions and their leads.</field>
    </record>

    <!-- Sales users may read sessions and work with the captured leads. -->
    <record id="sales_team.group_sale_salesman" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_scan_user'))]"/>
    </record>
</odoo>
