<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Scan fields are only shown on leads that came from a scan (D1). -->
    <record id="crm_lead_view_form_scan" model="ir.ui.view">
        <field name="name">crm.lead.form.scan</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Event Scan"
                      name="event_scan"
                      invisible="not scan_session_id">
                    <group>
                        <group>
                            <field name="scan_session_id" readonly="1"/>
                            <field name="event_registration_id" readonly="1"/>
                            <field name="scanned_by_id"/>
                            <field name="scan_time"/>
                        </group>
                        <group>
                            <field name="scan_score" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="client_scan_uuid" readonly="1"
                                   groups="base.group_no_one"/>
                        </group>
                    </group>
                    <field name="scan_note" placeholder="Note taken at the scan…"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_list_scan" model="ir.ui.view">
        <field name="name">crm.lead.list.scan</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expected_revenue']" position="after">
                <field name="scan_score" optional="hide" widget="badge"
                       decoration-danger="scan_score == 'hot'"
                       decoration-warning="scan_score == 'warm'"
                       decoration-info="scan_score == 'cold'"/>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_search_scan" model="ir.ui.view">
        <field name="name">crm.lead.search.scan</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='assigned_to_me']" position="after">
                <filter name="filter_scanned" string="Captured by Scan"
                        domain="[('scan_session_id', '!=', False)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_scan_session" string="Scan Session"
                        context="{'group_by': 'scan_session_id'}"/>
                <filter name="group_scan_score" string="Scan Score"
                        context="{'group_by': 'scan_score'}"/>
            </xpath>
        </field>
    </record>

    <!-- Pivot: rows = session, columns = score, measure = lead count (D7). -->
    <record id="view_crm_lead_scan_pivot" model="ir.ui.view">
        <field name="name">crm.lead.scan.pivot</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Scanned Leads" sample="1">
                <field name="scan_session_id" type="row"/>
                <field name="scan_score" type="col"/>
                <field name="scanned_by_id" type="row" invisible="1"/>
            </pivot>
        </field>
    </record>

    <record id="action_crm_lead_scan_report" model="ir.actions.act_window">
        <field name="name">Scanned Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="domain">[('scan_session_id', '!=', False)]</field>
        <field name="context">{'search_default_group_scan_session': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No scanned leads yet</p>
            <p>Leads captured by badge scanning appear here.</p>
        </field>
    </record>

    <menuitem id="menu_crm_lead_scan_report"
              name="Scanned Leads"
              parent="crm.crm_menu_report"
              action="action_crm_lead_scan_report"
              sequence="40"/>
</odoo>
