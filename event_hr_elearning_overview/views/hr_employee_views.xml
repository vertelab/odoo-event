<odoo>
    <data>
        <record id="view_employee_form_inherit" model="ir.ui.view">
            <field name="name">hr_employee_form_inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath postion="inside" expr="//div[@name='button_box']">
                    <button name="manager_course_overview" type="object" groups="hr.group_hr_user" invisible="not active or subordinate_course_participants_count == 0" class="oe_stat_button" icon="fa-graduation-cap">
                        <field name="subordinate_course_participants_count" string="Course Overview" widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
