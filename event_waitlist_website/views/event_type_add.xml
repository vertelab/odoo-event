<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="event_type_view_form_add" model="ir.ui.view">
        <field name="name">event.type.view.form.add</field>
        <field name="model">event.type</field>
        <field name="arch" type="xml">
            <form js_class="website_new_content_form">
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="name" string="Event Type Name"/>
                    <field name="address_id" context="{'show_address': 1}"/>
                </group>
            </form>
        </field>
    </record>

    <record id="event_type_action_add" model="ir.actions.act_window">
        <field name="name">New Event Type</field>
        <field name="res_model">event.type</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="event_type_view_form_add"/>
    </record>

</odoo>
