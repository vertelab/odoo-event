<odoo>
    <data>
        <record model="ir.ui.view" id="view_event_type_form">
            <field name="name">event.type.form</field>
            <field name="model">event.type</field>
            <field name="inherit_id" ref="event.view_event_type_form"/>
            <field name="arch" type="xml">
                <field name="tag_ids" position="before">
                    <field name="address_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="website_id" invisible="1"/>
                    <field name="website_id" options="{'no_create': True}" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" groups="website.group_multi_website"/>
                </field>

                <xpath expr="//sheet" position="inside">
                    <div class="oe_button_box" name="button_box" groups="base.group_user">
                        <field name="website_url" invisible="1"/>
                        <field name="is_published" widget="website_redirect_button"/>
                        <button name="action_view_waitlist" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="waiting_list_count" widget="statinfo" string="Waiting List"/>
                        </button>
                    </div>
                </xpath>

                <xpath expr="//group[1]/group[2]/div[1]" position="after">
<!--                    <field name="date_begin" string="Date" widget="daterange" options="{'end_date_field': 'date_end'}"/>-->
<!--                    <field name="date_end" invisible="1"/>-->
                    <field name="open_waiting_list"/>
                </xpath>

                <field name="ticket_instructions" position="after">
                    <label for="subtitle" string="Subtitle"/>
                    <br/>
                    <field nolabel="1" colspan="2" name="subtitle"/>
                    <label for="description" string="Description"/>
                    <br/>
                    <field nolabel="1" colspan="2" name="description"/>
                </field>

                <xpath expr="//page[last()]" position="after">
                    <page string="Events" name="event_type_events">
                        <field name="event_ids" class="w-100">
                            <list string="Events" editable="bottom">
                                <field name="name"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                <field name="date_begin"/>
                                <field name="date_end"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
