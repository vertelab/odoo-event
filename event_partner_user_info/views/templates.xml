<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="registration_template_course_size" inherit_id="website_event.registration_template" name="Show Course Size">
        <!-- Odoo 18: the ticket quantity selector sits next to the registration
             button. Anchor on the button (same robust anchor OCA uses) and add
             the seat count after the ticket selector block. -->
        <xpath expr="//button[@data-bs-target='#modal_ticket_registration']" position="after">
            <t t-if="event.seats_limited" class="col-lg my-2">
                <span>of</span>
                <strong t-field="event.seats_available"/>
            </t>
        </xpath>
    </template>
</odoo>
