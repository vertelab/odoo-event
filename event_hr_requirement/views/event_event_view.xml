<odoo>
    <data>
        <record id="event_event_form" model="ir.ui.view">
            <field name="name">event.event.form</field>
            <field name="model">event.event</field>
            <field name="inherit_id" ref="event.view_event_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='event_notes']" position="after">
                    <page string="Requirement" id="event_requirement">
                        <field mode="tree" nolabel="1" name="employee_skill_ids" widget="skills_one2many" class="mt-2">
                            <tree>
                                <field name="skill_id"/>
                                <field name="skill_level_id"/>
                                <field name="level_progress" widget="progressbar"/>
                                <field name="skill_type_id" optional="hidden"/>
                            </tree>
                        </field>
                        
                        <field mode="tree" nolabel="1" name="event_required_event_type_ids" widget="one2many_list" class="mt-2">
                            <tree>
                                <field name="name"/>
                            </tree>
                        </field>
                        
                    </page>
                </xpath>
            </field>
        </record>
        
        <record id="view_event_type_form" model="ir.ui.view">
            <field name="name">event.event.form</field>
            <field name="model">event.type</field>
            <field name="inherit_id" ref="event.view_event_type_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='notes']" position="after">
                    <page string="Requirement" id="event_requirement">
                        <field mode="tree" nolabel="1" name="employee_skill_ids" widget="skills_one2many" class="mt-2">
                            <tree>
                                <field name="skill_id"/>
                                <field name="skill_level_id"/>
                                <field name="level_progress" widget="progressbar"/>
                                <field name="skill_type_id" optional="hidden"/>
                            </tree>
                        </field>
                        
                        <field mode="tree" name="event_type_required_event_type_ids" widget="one2many_list" class="mt-2">
                            <tree>
                                <field name="name"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
    
    
    
</odoo>
