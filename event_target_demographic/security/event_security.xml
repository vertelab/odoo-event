<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="ir_rule_event_event_target_demographic_user" model="ir.rule">
            <field name="name">Event Target Demographic User</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="domain_force">[('target_demographic_id.user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('event.group_event_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="ir_rule_event_event_target_demographic_admin" model="ir.rule">
            <field name="name">Event Target Demographic Admin</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('event.group_event_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- security rules for website slides -->
        <function name="write" model="ir.model.data">
            <function name="search" model="ir.model.data">
                <value eval="[('module', '=', 'website_slides'), ('name', '=', 'rule_slide_channel_visibility_signed_in_user')]" />
            </function>
            <value eval="{'noupdate': False}" />
        </function>


            <record id="website_slides.rule_slide_channel_visibility_signed_in_user" model="ir.rule">
                <field name="domain_force">
[
    '|',
        ('target_demographic_id.user_ids', 'in', user.id),
        '&amp;',
            ('target_demographic_id', '=', False),
            '&amp;',
                ('website_published', '=', True),
                '|',
                    ('visibility', 'in', ('public', 'connected')),
                    '|',
                        ('is_member_invited', '=', True),
                        ('is_member', '=', True),
]

                </field>
            </record>

<!--        <function name="write" model="ir.model.data">-->
<!--            <function name="search" model="ir.model.data">-->
<!--                <value eval="[('module', '=', 'website_slides'), ('name', '=', 'rule_slide_channel_global')]" />-->
<!--            </function>-->
<!--            <value eval="{'noupdate': True}" />-->
<!--        </function>-->

    </data>
</odoo>
