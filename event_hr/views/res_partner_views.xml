<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.slides</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                    icon="fa-trophy" name="action_view_survey_inputs">
                    <div class="o_field_widget o_stat_info">
<!--                        <span class="o_stat_value"><field name="slide_channel_count"/></span>-->
                        <span class="o_stat_text">Certifications</span>
                    </div>
                </button>
            </xpath>
            <field name="category_id" position="after">
                <field name="survey_user_input_ids"/>
            </field>
        </field>
    </record>

</data></odoo>
