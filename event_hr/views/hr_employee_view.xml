<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
         <record id="view_hr_employee_form" model="ir.ui.view">
            <field name="name">hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <field name="category_ids" position="after">
                    <field name="slide_channel_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                </field>

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button type="object" name="action_view_completed_certification" class="oe_stat_button" icon="fa-trophy">
                        <field name="completed_certification_count" string="Certified" widget="statinfo"/>
                    </button>
                    <button type="object" name="action_view_recommended_certification" class="oe_stat_button" string="Recommended Courses" icon="fa-trophy">
                        <!--<field name="recommended_certification_count" string="Recommended Courses" widget="statinfo"/>-->
                    </button>
                </xpath>
<!--                <field name="work_location_id" position="after">-->
<!--                    <field name="recommended_certification_ids"/>-->
<!--                </field>-->
            </field>
         </record>
         
         
        <record id="view_hr_employee_form_search" model="ir.ui.view">
            <field name="name">hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='category_ids']" position="after">
                    <field name="slide_channel_tag_ids" groups="hr.group_hr_user"/>
                </xpath>
                
                <xpath expr="//filter[@name='group_category_ids']" position="after">
                    <filter name="group_slide_channel_tag_ids" string="Course Tags" domain="[]" context="{'group_by': 'slide_channel_tag_ids'}"/>
                </xpath>
                
            </field>
         </record>


        <record id="view_mandatory_edu_tree" model="ir.ui.view">
            <field name="name">mandatory.edu.form</field>
            <field name="model">mandatory.edu</field>
            <field name="arch" type="xml">
                <list
                        decoration-danger="date_end &gt; (context_today() - datetime.timedelta(days=lead_time)).strftime('%Y-%m-%d')"
                        decoration-success="date_end &lt; (context_today() - datetime.timedelta(days=lead_time)).strftime('%Y-%m-%d')"
                        decoration-warning="date_end &lt; (context_today() - datetime.timedelta(days=lead_time)).strftime('%Y-%m-%d')"
                        create="false"
                        edit="false"
                        delete="false"
                >
                    <field name="edu_reference" string="Kursnamn" optional="show" class="oe_inline" options="{'hide_model': True, 'no_create': True, 'no_open': True}"/>
<!--
                    <field name="edu_source_reference" optional="show" class="oe_inline" options="{'hide_model': True, 'no_create': True, 'no_open': True}"/>
-->
                    <field name="employee_id" optional="hide"/>
                    <field name="lead_time" optional="hide"/>
                    <field name="date_end" optional="show"/>
                    <field name="mandatory" optional="show"/>
                    <button name="action_view_course" string="Öppna Kurs" type="object" class="oe_highlight"/>
                </list>
            </field>
         </record>
    </data>
</odoo>
