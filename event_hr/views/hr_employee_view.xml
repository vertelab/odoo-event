<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
         <record id="view_hr_employee_form" model="ir.ui.view">
            <field name="name">hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button type="object" name="action_view_completed_certification" class="oe_stat_button" icon="fa-trophy">
                        <field name="completed_certification_count" string="Certified" widget="statinfo"/>
                    </button>
                    <button type="object" name="action_view_recommended_certification" class="oe_stat_button" icon="fa-trophy">
                        <field name="recommended_certification_count" string="Recommended Certification" widget="statinfo"/>
                    </button>
                </xpath>
<!--                <field name="work_location_id" position="after">-->
<!--                    <field name="recommended_certification_ids"/>-->
<!--                </field>-->
            </field>
         </record>
    </data>
</odoo>