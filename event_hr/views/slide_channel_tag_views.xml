<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="slide_channel_tag_view_form" model="ir.ui.view">
            <field name="name">slide.channel.tag.search</field>
            <field name="model">slide.channel.tag</field>
            <field name="inherit_id" ref="website_slides.slide_channel_tag_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[last()]" position="after">
                    <notebook>
                        <page string="Courses" name="courses">
                            <field name="channel_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="is_published"/>
                                </list>
                            </field>
                        </page>
                        <page string="Certifications" name="certifications">
                            <field name="survey_survey_ids">
                                <list create="false" delete="false">
                                    <field name="title"/>
                                    <field name="user_id"/>
                                    <field name="department_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
    </data>
</odoo>