<odoo>
    <data>
        <record id="account_fiscalyear_multi_company_rule" model="ir.rule">
            <field name="name">account_fiscalyear: Account Fiscal Year Multi-Company Rule</field>
            <field name="model_id" ref="account_period_vrtl.model_account_fiscalyear"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="account_period_company_rule" model="ir.rule">
            <field name="name">account_period: Account Period Multi-Company Rule</field>
            <field name="model_id" ref="account_period_vrtl.model_account_period"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="group_lms_elearning_admin" model="res.groups">
            <field name="name">E-Learning Admin</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('website_slides.group_website_slides_manager')), (4, ref('event.group_event_manager'))]"/>
        </record>

        <function model="ir.ui.menu" name="update_elearning_group">
            <value eval="[ref('website_slides.website_slides_menu_root'), ref('event.event_main_menu')]"/>
        </function>

    </data>
</odoo>
