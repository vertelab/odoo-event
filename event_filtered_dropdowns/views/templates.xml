<odoo>
    <template id="address_force_sweden" name="Only Sweden" inherit_id="website_sale.address">
        <!-- Hide country selector -->
        <xpath expr="//div[@id='div_country']" position="attributes">
            <attribute name="style">display:none !important;</attribute>
        </xpath>

        <!-- Filter to only show Sweden option -->
        <xpath expr="//select[@id='o_country_id']//t[@t-foreach='countries']" position="replace">
            <t t-foreach="countries" t-as="c">
                <t t-if="c.code == 'SE'">
                    <option t-att-value="c.id" selected="selected" t-att-code="c.code">
                        <t t-esc="c.name" />
                    </option>
                </t>
            </t>
        </xpath>
    </template>
</odoo>