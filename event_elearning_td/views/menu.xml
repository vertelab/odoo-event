<odoo>
    <data>
        <record id="view_target_demographic_form" model="ir.ui.view">
            <field name="name">event.target.demographic.form</field>
            <field name="model">event.target.demographic</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="model_name" invisible="1" />
                            <field name="domain" widget="domain" options="{'model': 'model_name', 'foldable': true}"/>
                            <field name="user_ids"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_target_demographic_list" model="ir.ui.view">
            <field name="name">event.target.demographic.list</field>
            <field name="model">event.target.demographic</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="model_id"/>
                </list>
            </field>
        </record>

        <record id="action_target_demographic" model="ir.actions.act_window">
            <field name="name">Target Demographic</field>
            <field name="res_model">event.target.demographic</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="menu_target_demographic"
            name="Target Demographic"
            parent="event.menu_event_configuration"
            sequence="50"
            action="action_target_demographic"
            groups="base.group_system"/>
    </data>
</odoo>
